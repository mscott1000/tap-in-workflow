  async function processCurrentRowOnResultsPage(st) {
    const row = st.rows[st.idx];
    if (!row) return { done: true };

    const ready = await waitForResultsReady();
    if (!ready.ready) {
      dbg('results_not_ready_timeout', { idx: st.idx, rowIndex: row.rowIndex });
      return { done: false, fatal: false, note: 'Results not ready (timeout)' };
    }
    if (ready.noMatches) {
      appendResultRow(row, null, 'NO RESULTS');
      return { done: true, matched: false };
    }

    setShowEntriesTo100();
    uiStatus(`Row ${st.idx + 1}/${st.rows.length}: harvesting cases…`);
    render();

    const cases = await harvestAllResultCaseKeys();
    dbg('harvest_done', { idx: st.idx, count: cases.length });

    if (!cases.length) {
      appendResultRow(row, null, 'NO CASE LINKS FOUND');
      return { done: true, matched: false };
    }

    if (isStop()) return { done: false, stopped: true };

    uiStatus(`Row ${st.idx + 1}/${st.rows.length}: checking ${cases.length} candidates…`);
    render();

    const { results, errors } = await runPool(
      cases,
      Math.max(1, st.conc),
      async (caseRef) => {
        if (isStop()) return null;
        await sleep(60);
        return await evaluateCandidateCase(caseRef, row);
      }
    );

    if (errors?.length) {
      st.stats.errors += errors.length;
      dbg('candidate_errors', { idx: st.idx, count: errors.length, sample: errors.slice(0, 6) });
    }

    const best = pickBestPassed(results, row);
    if (!best) {
      // Helpful notes: top rejection reasons summary
      const reasons = (results || [])
        .filter(Boolean)
        .flatMap((c) => (c?.reasons || []).map((x) => String(x)));
      const top = {};
      for (const r of reasons) top[r] = (top[r] || 0) + 1;
      const topList = Object.entries(top).sort((a,b) => b[1]-a[1]).slice(0, 3).map(([k,v]) => `${k}×${v}`).join('; ');
      appendResultRow(row, null, topList ? `NO MATCH — ${topList}` : 'NO MATCH');
      return { done: true, matched: false };
    }

    appendResultRow(row, best, best.recallDate ? `Recall: ${best.recallDate}` : '');
    return { done: true, matched: true };
  }

  async function batchTick() {
    const st = loadState();
    if (!st?.active) return;
    if (isRun()) return;
    if (isStop()) return;

    const total = st.rows?.length || 0;
    if (st.idx >= total) {
      st.active = false;
      st.step = 'idle';
      st.finishedAt = new Date().toISOString();
      saveState(st);
      uiStatus(`Done. ${st.stats.done}/${st.stats.total} processed. Found: ${st.stats.found}. No match: ${st.stats.none}.`);
      render();
      dbg('batch_done', { stats: st.stats });
      return;
    }

    const row = st.rows[st.idx];
    const who = `${row.first} ${row.last}`.trim();
    const yob = row.yob || '';
    const lvl = row.chargeLevel || '';
    const svc = row.serviceDateStr || '';

    if (st.step === 'go_search') {
      uiStatus(`Row ${st.idx + 1}/${total}: searching ${who} (YOB ${yob}) — ${svc} — ${lvl || 'level?'}…`);
      render();
      setRun(true);
      clearRunArtifacts();

      if (!isNameSearchPage()) {
        dbg('nav_to_namesearch', { idx: st.idx });
        location.href = canonicalNameSearchUrl();
        st.step = 'go_search';
        saveState(st);
        setRun(false);
        return;
      }

      fillNameSearchForm({ first: row.first, last: row.last, yob: row.yob });
      const ok = submitNameSearchForm();
      if (!ok) {
        st.stats.done += 1;
        st.stats.none += 1;
        appendResultRow(row, null, 'SUBMIT FAILED');
        dbg('submit_failed', { idx: st.idx, rowIndex: row.rowIndex });
        st.idx += 1;
        st.step = 'go_search';
        saveState(st);
        setRun(false);
        render();
        return;
      }

      st.step = 'waiting_results';
      st.lastProgressTs = Date.now();
      saveState(st);
      setRun(false);
      return;
    }

    if (st.step === 'waiting_results') {
      // Wait until we land on results page
      if (isNameSearchResultsPage() || isNoMatchesMessagePage()) {
        st.step = 'processing_results';
        saveState(st);
        return;
      }
      // If we got stuck somewhere odd, recover
      const age = Date.now() - Number(st.lastProgressTs || 0);
      if (age > 15000) {
        dbg('waiting_results_timeout_recover', { idx: st.idx, ageMs: age });
        location.href = canonicalNameSearchUrl();
        st.step = 'go_search';
        saveState(st);
      }
      return;
    }

    if (st.step === 'processing_results') {
      if (!isNameSearchResultsPage() && !isNoMatchesMessagePage()) {
        // unexpected
        dbg('processing_not_on_results', { idx: st.idx });
        location.href = canonicalNameSearchUrl();
        st.step = 'go_search';
        saveState(st);
        return;
      }

      setRun(true);
      try {
        const res = await processCurrentRowOnResultsPage(st);
        st.stats.done += 1;
        if (res?.matched) st.stats.found += 1;
        else st.stats.none += 1;
      } catch (e) {
        st.stats.done += 1;
        st.stats.none += 1;
        appendResultRow(row, null, `FATAL: ${String(e?.message || e).slice(0, 120)}`);
        dbg('row_fatal', { idx: st.idx, msg: String(e?.message || e), stack: String(e?.stack || '') });
      } finally {
        setRun(false);
      }

      st.idx += 1;
      st.step = 'go_search';
      saveState(st);

      // Always return to canonical name search between rows
      location.href = canonicalNameSearchUrl();
      render();
      return;
    }
  }
