  dock.id = 'moJsonDock';
  dock.innerHTML = `
    <div id="moJsonHeader">
      <div class="title">Tap In Center — Batch Case # Retrieval</div>
      <div class="btnRow">
        <button class="moBtn" id="moJsonCopy">Copy</button>
        <button class="moBtn" id="moJsonStop">Stop</button>
      </div>
      <button id="moJsonCloseX" title="Close">×</button>
    </div>
    <div id="moJsonStatus">Ready.</div>
    <div id="moJsonContent"></div>
    <div id="moJsonFooter">
      <div class="moBottomRow">
        <button class="moBtn" id="moJsonClearEntries">Clear Entries</button>
        <button class="moBtn" id="moJsonClear">Clear Log</button>
      </div>
    </div>
  `;
  (document.body || document.documentElement).appendChild(dock);

  const $status = dock.querySelector('#moJsonStatus');
  const $content = dock.querySelector('#moJsonContent');

  function uiStatus(msg) { $status.textContent = msg; setStatus(msg); }

  function addBlock(title, htmlInner) {
    const div = document.createElement('div');
    div.className = 'moBlock';
    div.innerHTML = `<h3>${escapeHtml(title)}</h3>${htmlInner}`;
    $content.appendChild(div);
  }

  function loadDraft() { return loadJson(KEY_UI_DRAFT, { text: '', conc: DEFAULT_CONCURRENCY }); }
  function saveDraft(d) { saveJson(KEY_UI_DRAFT, d || { text: '', conc: DEFAULT_CONCURRENCY }); }

  function render() {
    const st = loadState();
    const log = loadLog();
    const draft = loadDraft();

    $content.innerHTML = '';

    addBlock('Batch Input (paste rows from Google Sheets)', `
      <textarea id="ticBatchText" class="moBatchArea" placeholder="Paste tab-delimited rows here...">${escapeHtml(draft.text || '')}</textarea>
      <div class="moGoRow">
        <button id="ticGo" class="moGoBtn">GO — Start Batch Search (Criminal)</button>
        <button id="ticOpenLastHtml" class="moBtn moSmallBtn">Open Last HTML</button>
      </div>
      <div style="margin-top:8px; font-size:12px; color:var(--mo-muted);">
        Concurrency per person:
        <input id="ticConc" type="number" min="1" max="8" value="${escapeHtml(String(draft.conc || DEFAULT_CONCURRENCY))}"
               style="width:64px; padding:6px 8px; border:1px solid var(--mo-border); border-radius:10px; margin-left:6px;">
        <span style="margin-left:10px;">Recommended: 3–4</span>
      </div>
    `);

    addBlock('Status', `
      <pre style="margin:0; font-size:13px; line-height:1.45; white-space:pre-wrap; word-break:break-word; color:#111;">
Running?: ${isRun() ? 'Yes' : 'No'}
Stop?: ${isStop() ? 'Yes' : 'No'}
Rows queued: ${(st?.rows?.length || 0)}
Row index: ${(st?.idx || 0)} / ${(st?.rows?.length || 0)}
Results in Log: ${log.length}

Found: ${st?.stats?.found || 0}
No match: ${st?.stats?.none || 0}
Errors: ${st?.stats?.errors || 0}
      </pre>
    `);
  }

  /************************************************************
   * Buttons + inputs
   ************************************************************/
  dock.addEventListener('click', async (e) => {
    const id = e?.target?.id;

    if (id === 'ticGo') {
      setStop(false);
      setRun(false);
      clearRunArtifacts();

      const text = dock.querySelector('#ticBatchText')?.value || '';
      const conc = Number(dock.querySelector('#ticConc')?.value || DEFAULT_CONCURRENCY) || DEFAULT_CONCURRENCY;

      // Start fresh batch: clear log+debug automatically (safer for large runs)
      saveLog([]);
      saveDebug([]);
      clearState();

      saveDraft({ text, conc });

      const st = startBatchFromTextarea(text, conc);
      uiStatus(`Batch loaded: ${st.rows.length} rows. Starting…`);
      dbg('batch_start', { rows: st.rows.length, conc });

      // Navigate to name search page to begin
      if (!isNameSearchPage()) location.href = canonicalNameSearchUrl();
      render();
      return;
    }

    if (id === 'moJsonStop') {
      setStop(true);
      setRun(false);
      uiStatus('Stopped.');
      dbg('stop_clicked', {});
      render();
      return;
    }

    if (id === 'moJsonCopy') {
      const out = buildCopyTable();
      GM_setClipboard(out || '', 'text');
      uiStatus('Copied to Clipboard');
      render();
      return;
    }

    if (id === 'moJsonClearEntries') {
      saveDraft({ text: '', conc: loadDraft().conc || DEFAULT_CONCURRENCY });
      uiStatus('Entries Cleared');
      dbg('entries_cleared', {});
      render();
      return;
    }

    if (id === 'moJsonClear') {
      saveLog([]);
      saveDebug([]);
      clearRunArtifacts();
      clearState();
      setStop(true);
      setRun(false);
      uiStatus('Log Cleared');
      dbg('log_cleared', {});
      render();
      return;
    }

    if (id === 'ticOpenLastHtml') {
      openLastHtmlInNewTab();
      return;
    }

    if (id === 'moJsonCloseX') {
      dock.classList.add('moHidden');
      return;
    }
  });

  dock.addEventListener('input', (e) => {
    const id = e?.target?.id;
    if (id === 'ticBatchText' || id === 'ticConc') {
      const text = dock.querySelector('#ticBatchText')?.value || '';
      const conc = Number(dock.querySelector('#ticConc')?.value || DEFAULT_CONCURRENCY) || DEFAULT_CONCURRENCY;
      saveDraft({ text, conc });
    }
  });

  /************************************************************
   * INIT
   ************************************************************/
  uiStatus(getStatus() || 'Ready.');
  render();

  setInterval(() => {
    try { batchTick(); }
    catch (e) { dbg('tick_error', { msg: String(e?.message || e) }); }
  }, 900);

})();
