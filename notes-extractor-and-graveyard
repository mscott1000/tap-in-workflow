/***************************************************************
 * MAIN TIC IMPORT FUNCTION
 ***************************************************************/

function importIntakeRange() {
  const ui = SpreadsheetApp.getUi();

  try {
    const spreadsheet =
      SpreadsheetApp.getActiveSpreadsheet();

    const sourceSheet =
      chooseSourceSheet_(
        spreadsheet,
        ui
      );

    if (!sourceSheet) {
      return;
    }


    const destinationSheet =
      spreadsheet.getSheetByName(
        DESTINATION_SHEET_NAME
      );


    if (!destinationSheet) {
      throw new Error(
        `Destination tab "${DESTINATION_SHEET_NAME}" was not found.`
      );
    }


    if (
      sourceSheet.getSheetId() ===
      destinationSheet.getSheetId()
    ) {
      throw new Error(
        `The source sheet cannot also be "${DESTINATION_SHEET_NAME}".`
      );
    }


    /***********************************************************
     * ASK FOR ROW RANGE
     ***********************************************************/

    const rangeResponse =
      ui.prompt(
        "Rows to import",

        `Source tab: ${sourceSheet.getName()}\n\n` +
        `Columns A and B will be ignored.\n` +
        `Intake data begins in column C.\n\n` +
        `Enter the rows to import.\n\n` +
        `Examples:\n` +
        `3-193\n` +
        `Row 3 - Row 193\n` +
        `3:193`,

        ui.ButtonSet.OK_CANCEL
      );


    if (
      rangeResponse.getSelectedButton() !==
      ui.Button.OK
    ) {
      return;
    }


    const rowRange =
      parseRowRange_(
        rangeResponse.getResponseText()
      );


    if (
      rowRange.startRow <=
      SOURCE_HEADER_ROW
    ) {
      throw new Error(
        `The import range must begin below the header row.\n\n` +
        `Header row: ${SOURCE_HEADER_ROW}`
      );
    }


    if (
      rowRange.endRow >
      sourceSheet.getMaxRows()
    ) {
      throw new Error(
        `Row ${rowRange.endRow} does not exist on ` +
        `"${sourceSheet.getName()}".`
      );
    }


    /***********************************************************
     * VALIDATE SOURCE + DESTINATION
     ***********************************************************/

    validateSourceHeaders_(
      sourceSheet
    );

    validateDestinationHeaders_(
      destinationSheet
    );


    /***********************************************************
     * READ SOURCE
     ***********************************************************/

    const sourceData =
      readSourceRows_(
        sourceSheet,
        rowRange.startRow,
        rowRange.endRow
      );


    /***********************************************************
     * DEDUPLICATE
     ***********************************************************/

    const grouped =
      groupSourceRecords_(
        sourceData
      );


    const mergeResult =
      mergeGroupedRecords_(
        grouped
      );


    /*
     * If conflicting duplicate information exists,
     * NOTHING is written.
     */
    if (
      mergeResult.conflicts.length > 0
    ) {
      showConflictAlert_(
        ui,
        sourceSheet,
        rowRange,
        mergeResult.conflicts
      );

      return;
    }


    const records =
      mergeResult.records;


    if (
      records.length === 0
    ) {
      ui.alert(
        "TIC Import",
        "No nonblank client rows were found in that range.",
        ui.ButtonSet.OK
      );

      return;
    }


    /***********************************************************
     * FIND EXISTING DESTINATION RECORDS
     ***********************************************************/

    const destinationIndex =
      buildDestinationIndex_(
        destinationSheet
      );


    let nextNewRow =
      Math.max(
        destinationSheet.getLastRow() + 1,
        DESTINATION_HEADER_ROW + 1
      );


    let added = 0;
    let updated = 0;


    records.forEach(
      record => {

        if (
          destinationIndex.has(
            record.key
          )
        ) {
          /*
           * Existing client/week.
           */
          record.destinationRow =
            destinationIndex.get(
              record.key
            );

          record.isNew = false;

          updated++;

        } else {
          /*
           * New client/week.
           */
          record.destinationRow =
            nextNewRow++;

          record.isNew = true;

          destinationIndex.set(
            record.key,
            record.destinationRow
          );

          added++;
        }
      }
    );


    /***********************************************************
     * WRITE RECORDS
     ***********************************************************/

    records.forEach(
      record => {

        writeRecord_(
          sourceSheet,
          destinationSheet,
          record
        );
      }
    );


    SpreadsheetApp.flush();


    /***********************************************************
     * SUMMARY
     ***********************************************************/

    const nonBlankSourceRows =
      sourceData.filter(
        row => !row.isBlank
      ).length;


    const duplicateRowsConsolidated =
      nonBlankSourceRows -
      records.length;


    ui.alert(
      "TIC Import Complete",

      `Source: ${sourceSheet.getName()}\n` +
      `Rows: ${rowRange.startRow}-${rowRange.endRow}\n` +
      `Source columns: C:AA\n` +
      `Columns A and B ignored\n\n` +

      `${records.length} unique client record(s) processed\n` +
      `${added} new record(s) added\n` +
      `${updated} existing record(s) updated\n` +
      `${duplicateRowsConsolidated} duplicate source row(s) consolidated\n` +
      `0 conflicts detected`,

      ui.ButtonSet.OK
    );


  } catch (error) {
    console.error(error);

    ui.alert(
      "TIC Import Error",
      error.message || String(error),
      ui.ButtonSet.OK
    );
  }
}


/***************************************************************
 * CHOOSE SOURCE TAB
 ***************************************************************/

function chooseSourceSheet_(
  spreadsheet,
  ui
) {
  const activeSheet =
    spreadsheet.getActiveSheet();


  /*
   * Automatically use the active sheet if its name begins
   * with "Intake".
   */
  if (
    activeSheet &&
    /^Intake\b/i.test(
      activeSheet.getName()
    )
  ) {
    return activeSheet;
  }


  /*
   * Otherwise ask for the source tab name.
   */
  const response =
    ui.prompt(
      "Source intake tab",

      `Enter the exact weekly intake tab name.\n\n` +
      `Example:\n` +
      `Intake 2026_Sept 15`,

      ui.ButtonSet.OK_CANCEL
    );


  if (
    response.getSelectedButton() !==
    ui.Button.OK
  ) {
    return null;
  }


  const sheetName =
    response
      .getResponseText()
      .trim();


  if (!sheetName) {
    throw new Error(
      "No source sheet name was entered."
    );
  }


  const sheet =
    spreadsheet.getSheetByName(
      sheetName
    );


  if (!sheet) {
    throw new Error(
      `Could not find a sheet named "${sheetName}".`
    );
  }


  return sheet;
}


/***************************************************************
 * PARSE ROW RANGE
 ***************************************************************/

function parseRowRange_(input) {
  let text =
    String(input || "")
      .trim()
      .replace(
        /\brows?\b/gi,
        ""
      )
      .trim();


  /*
   * Accept:
   *
   * 3-193
   * 3 - 193
   * 3:193
   * 3 to 193
   */
  let match =
    text.match(
      /^(\d+)\s*(?:-|:|\bto\b)\s*(\d+)$/i
    );


  /*
   * Also accept one row:
   *
   * 15
   */
  if (!match) {
    match =
      text.match(
        /^(\d+)$/
      );


    if (match) {
      const row =
        Number(
          match[1]
        );

      return {
        startRow: row,
        endRow: row
      };
    }


    throw new Error(
      `Could not understand the row range "${input}".\n\n` +
      `Use a format such as:\n` +
      `3-193`
    );
  }


  const startRow =
    Number(
      match[1]
    );

  const endRow =
    Number(
      match[2]
    );


  if (
    !Number.isInteger(startRow) ||
    !Number.isInteger(endRow) ||
    startRow < 1 ||
    endRow < 1
  ) {
    throw new Error(
      "Row numbers must be positive whole numbers."
    );
  }


  if (
    endRow <
    startRow
  ) {
    throw new Error(
      `The ending row (${endRow}) comes before ` +
      `the starting row (${startRow}).`
    );
  }


  return {
    startRow,
    endRow
  };
}


/***************************************************************
 * VALIDATE SOURCE HEADERS
 ***************************************************************/

function validateSourceHeaders_(
  sheet
) {
  const actual =
    sheet
      .getRange(
        SOURCE_HEADER_ROW,
        SOURCE_START_COLUMN,
        1,
        SOURCE_HEADERS.length
      )
      .getDisplayValues()[0]
      .map(
        normalizeHeader_
      );


  const problems = [];


  SOURCE_HEADERS.forEach(
    (expected, index) => {

      if (
        actual[index] !==
        expected
      ) {
        const physicalColumn =
          SOURCE_START_COLUMN +
          index;


        problems.push(
          `Column ${columnLetter_(physicalColumn)}: ` +
          `expected "${expected}", ` +
          `found "${actual[index] || "(blank)"}"`
        );
      }
    }
  );


  if (
    problems.length > 0
  ) {
    throw new Error(
      `The source sheet "${sheet.getName()}" does not match ` +
      `the expected Intake format.\n\n` +

      `IMPORTANT: Columns A and B are intentionally ignored.\n` +
      `The 25-column Intake dataset must begin in COLUMN C.\n\n` +

      `Expected source range:\n` +
      `C:AA\n\n` +

      problems.join("\n")
    );
  }
}


/***************************************************************
 * VALIDATE DESTINATION HEADERS
 ***************************************************************/

function validateDestinationHeaders_(
  sheet
) {
  const actual =
    sheet
      .getRange(
        DESTINATION_HEADER_ROW,
        1,
        1,
        DESTINATION_HEADERS.length
      )
      .getDisplayValues()[0]
      .map(
        normalizeHeader_
      );


  const problems = [];


  DESTINATION_HEADERS.forEach(
    (expected, index) => {

      if (
        actual[index] !==
        expected
      ) {
        problems.push(
          `Column ${columnLetter_(index + 1)}: ` +
          `expected "${expected}", ` +
          `found "${actual[index] || "(blank)"}"`
        );
      }
    }
  );


  if (
    problems.length > 0
  ) {
    throw new Error(
      `"${DESTINATION_SHEET_NAME}" does not match ` +
      `the expected destination format.\n\n` +
      problems.join("\n")
    );
  }
}


/***************************************************************
 * NORMALIZE HEADER
 ***************************************************************/

function normalizeHeader_(
  value
) {
  return String(
    value || ""
  )
    .replace(
      /\u00A0/g,
      " "
    )
    .trim();
}


/***************************************************************
 * READ SOURCE ROWS
 ***************************************************************/

function readSourceRows_(
  sheet,
  startRow,
  endRow
) {
  const rowCount =
    endRow -
    startRow +
    1;


  /*
   * Read only C:AA.
   *
   * A and B are ignored.
   */
  const range =
    sheet.getRange(
      startRow,
      SOURCE_START_COLUMN,
      rowCount,
      SOURCE_HEADERS.length
    );


  const values =
    range.getDisplayValues();

  const notes =
    range.getNotes();


  const headerIndex = {};


  SOURCE_HEADERS.forEach(
    (header, index) => {

      headerIndex[header] =
        index;
    }
  );


  return values.map(
    (row, localIndex) => {

      const sheetRow =
        startRow +
        localIndex;


      const isBlank =
        row.every(
          value =>
            String(
              value || ""
            ).trim() === ""
        );


      return {
        sheetRow: sheetRow,
        values: row,
        notes: notes[localIndex],
        headerIndex: headerIndex,
        isBlank: isBlank
      };
    }
  );
}


/***************************************************************
 * GROUP SOURCE RECORDS BY:
 *
 * TIC Week + First Name + Last Name + DOB
 ***************************************************************/

function groupSourceRecords_(
  rows
) {
  const groups =
    new Map();


  rows.forEach(
    row => {

      if (
        row.isBlank
      ) {
        return;
      }


      const dateValue =
        row.values[
          row.headerIndex["Date"]
        ];

      const firstName =
        row.values[
          row.headerIndex["FN"]
        ];

      const lastName =
        row.values[
          row.headerIndex["LN"]
        ];

      const dob =
        row.values[
          row.headerIndex["DOB"]
        ];


      const missing = [];


      if (
        isBlank_(
          dateValue
        )
      ) {
        missing.push(
          "Date"
        );
      }


      if (
        isBlank_(
          firstName
        )
      ) {
        missing.push(
          "FN"
        );
      }


      if (
        isBlank_(
          lastName
        )
      ) {
        missing.push(
          "LN"
        );
      }


      if (
        isBlank_(
          dob
        )
      ) {
        missing.push(
          "DOB"
        );
      }


      if (
        missing.length > 0
      ) {
        throw new Error(
          `Source row ${row.sheetRow} cannot be identified because ` +
          `the following key field(s) are blank:\n\n` +
          missing.join(", ")
        );
      }


      const ticWeek =
        normalizeTICWeek_(
          dateValue,
          row.sheetRow
        );


      row.ticWeek =
        ticWeek;


      const key =
        makeClientKey_(
          ticWeek.display,
          firstName,
          lastName,
          dob
        );


      row.key =
        key;


      if (
        !groups.has(
          key
        )
      ) {
        groups.set(
          key,
          []
        );
      }


      groups
        .get(
          key
        )
        .push(
          row
        );
    }
  );


  return groups;
}


/***************************************************************
 * MERGE DUPLICATES
 ***************************************************************/

function mergeGroupedRecords_(
  groups
) {
  const records = [];
  const conflicts = [];


  groups.forEach(
    (rows, key) => {

      const firstRow =
        rows[0];


      const mergedValues = {};
      const mergedCellNotes = {};


      FIELD_MAP.forEach(
        mapping => {

          const destinationField =
            mapping.destination;

          const sourceField =
            mapping.source;


          const sourceIndex =
            firstRow.headerIndex[
              sourceField
            ];


          const valueEntries = [];
          const cellNoteEntries = [];


          rows.forEach(
            row => {

              let value =
                row.values[
                  sourceIndex
                ];


              /*
               * Source Date becomes TIC Week.
               */
              if (
                sourceField ===
                "Date"
              ) {
                value =
                  row.ticWeek.display;
              }


              if (
                !isBlank_(
                  value
                )
              ) {
                valueEntries.push({
                  value: value,

                  normalized:
                    normalizeComparisonValue_(
                      value
                    ),

                  row:
                    row.sheetRow
                });
              }


              /*
               * Preserve Google Sheets cell Notes as well.
               */
              const cellNote =
                row.notes[
                  sourceIndex
                ];


              if (
                !isBlank_(
                  cellNote
                )
              ) {
                cellNoteEntries.push({
                  value: cellNote,

                  normalized:
                    normalizeComparisonValue_(
                      cellNote
                    ),

                  row:
                    row.sheetRow
                });
              }
            }
          );


          /*
           * Merge unique cell-note metadata.
           */
          mergedCellNotes[
            destinationField
          ] =
            mergeUniqueEntries_(
              cellNoteEntries
            );


          /*
           * Eligible Cases,
           * Ineligible Cases,
           * Notes
           *
           * may contain multiple unique values.
           */
          if (
            ADDITIVE_FIELDS.has(
              destinationField
            )
          ) {
            mergedValues[
              destinationField
            ] =
              mergeUniqueEntries_(
                valueEntries
              );

            return;
          }


          /*
           * All other fields should have at most one
           * unique nonblank value.
           */
          const uniqueEntries =
            uniqueEntries_(
              valueEntries
            );


          if (
            uniqueEntries.length > 1
          ) {
            conflicts.push({
              key: key,
              field: destinationField,

              rows:
                uniqueEntries.flatMap(
                  entry =>
                    entry.rows
                ),

              values:
                uniqueEntries.map(
                  entry =>
                    entry.value
                )
            });

            return;
          }


          mergedValues[
            destinationField
          ] =
            uniqueEntries.length
              ? uniqueEntries[0].value
              : "";
        }
      );


      records.push({
        key: key,

        sourceRows:
          rows.map(
            row =>
              row.sheetRow
          ),

        /*
         * Formatting comes from the first row in the duplicate group.
         */
        formatSourceRow:
          firstRow.sheetRow,

        values:
          mergedValues,

        cellNotes:
          mergedCellNotes,

        ticWeek:
          firstRow.ticWeek,

        destinationRow:
          null,

        isNew:
          null
      });
    }
  );


  return {
    records: records,
    conflicts: conflicts
  };
}


/***************************************************************
 * INDEX EXISTING GRAVEYARD PROTOTYPE RECORDS
 ***************************************************************/

function buildDestinationIndex_(
  sheet
) {
  const index =
    new Map();


  const lastRow =
    sheet.getLastRow();


  if (
    lastRow <=
    DESTINATION_HEADER_ROW
  ) {
    return index;
  }


  const rowCount =
    lastRow -
    DESTINATION_HEADER_ROW;


  const data =
    sheet
      .getRange(
        DESTINATION_HEADER_ROW + 1,
        1,
        rowCount,
        DESTINATION_HEADERS.length
      )
      .getDisplayValues();


  data.forEach(
    (row, localIndex) => {

      const sheetRow =
        DESTINATION_HEADER_ROW +
        1 +
        localIndex;


      const ticWeek =
        row[0];

      const firstName =
        row[1];

      const lastName =
        row[2];

      const dob =
        row[4];


      /*
       * Ignore empty rows.
       */
      if (
        isBlank_(ticWeek) &&
        isBlank_(firstName) &&
        isBlank_(lastName) &&
        isBlank_(dob)
      ) {
        return;
      }


      /*
       * Do not index incomplete keys.
       */
      if (
        isBlank_(ticWeek) ||
        isBlank_(firstName) ||
        isBlank_(lastName) ||
        isBlank_(dob)
      ) {
        return;
      }


      const normalizedWeek =
        normalizeTICWeek_(
          ticWeek,
          sheetRow
        );


      const key =
        makeClientKey_(
          normalizedWeek.display,
          firstName,
          lastName,
          dob
        );


      if (
        index.has(
          key
        )
      ) {
        throw new Error(
          `Duplicate client records already exist in ` +
          `"${DESTINATION_SHEET_NAME}".\n\n` +

          `Rows ${index.get(key)} and ${sheetRow} have the same:\n` +
          `TIC Week + First Name + Last Name + DOB.\n\n` +

          `Please resolve that duplication before importing.`
        );
      }


      index.set(
        key,
        sheetRow
      );
    }
  );


  return index;
}


/***************************************************************
 * WRITE ONE RECORD TO GRAVEYARD PROTOTYPE
 ***************************************************************/

function writeRecord_(
  sourceSheet,
  destinationSheet,
  record
) {
  const row =
    record.destinationRow;

  const values =
    record.values;

  const notes =
    record.cellNotes;


