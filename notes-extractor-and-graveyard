  sourceSheet
    .getRange(
      sourceRow,
      SOURCE_START_COLUMN + 18
    )
    .copyFormatToRange(
      destinationGridId,
      22,
      22,
      destinationRow,
      destinationRow
    );
}


/***************************************************************
 * NORMALIZE TIC WEEK
 ***************************************************************/

function normalizeTICWeek_(
  value,
  rowNumber
) {
  const original =
    String(
      value || ""
    ).trim();


  if (!original) {
    throw new Error(
      `Blank TIC Week / Date on row ${rowNumber}.`
    );
  }


  /*
   * Accept:
   *
   * 7/7
   * 07/07
   * 7-7
   * 7/7/26
   * 7/7/2026
   */
  const match =
    original.match(
      /^(\d{1,2})[\/-](\d{1,2})(?:[\/-](\d{2}|\d{4}))?$/
    );


  if (!match) {
    throw new Error(
      `Could not understand Date "${original}" ` +
      `on row ${rowNumber}.`
    );
  }


  const month =
    Number(
      match[1]
    );

  const day =
    Number(
      match[2]
    );


  if (
    month < 1 ||
    month > 12 ||
    day < 1 ||
    day > 31
  ) {
    throw new Error(
      `Invalid Date "${original}" on row ${rowNumber}.`
    );
  }


  let year =
    TIC_DATA_YEAR;


  if (
    match[3]
  ) {
    year =
      Number(
        match[3]
      );


    if (
      year < 100
    ) {
      year +=
        2000;
    }


    if (
      year !==
      TIC_DATA_YEAR
    ) {
      throw new Error(
        `Row ${rowNumber} contains TIC Week "${original}".\n\n` +
        `This importer is currently configured for ${TIC_DATA_YEAR}.`
      );
    }
  }


  const dateObject =
    new Date(
      year,
      month - 1,
      day
    );


  /*
   * Reject impossible dates such as 2/31.
   */
  if (
    dateObject.getFullYear() !== year ||
    dateObject.getMonth() !== month - 1 ||
    dateObject.getDate() !== day
  ) {
    throw new Error(
      `Invalid calendar date "${original}" ` +
      `on row ${rowNumber}.`
    );
  }


  return {
    display:
      `${month}/${day}/${year}`,

    dateObject:
      dateObject
  };
}


/***************************************************************
 * CREATE CLIENT KEY
 ***************************************************************/

function makeClientKey_(
  ticWeek,
  firstName,
  lastName,
  dob
) {
  return [
    normalizeKeyText_(
      ticWeek
    ),

    normalizeKeyText_(
      firstName
    ),

    normalizeKeyText_(
      lastName
    ),

    normalizeDOBKey_(
      dob
    )

  ].join(
    "||"
  );
}


/***************************************************************
 * NORMALIZE GENERAL KEY TEXT
 ***************************************************************/

function normalizeKeyText_(
  value
) {
  return String(
    value || ""
  )
    .trim()
    .replace(
      /\s+/g,
      " "
    )
    .toLowerCase();
}


/***************************************************************
 * NORMALIZE DOB FOR MATCHING ONLY
 ***************************************************************/

function normalizeDOBKey_(
  value
) {
  const text =
    String(
      value || ""
    ).trim();


  const match =
    text.match(
      /^(\d{1,2})[\/-](\d{1,2})[\/-](\d{2}|\d{4})$/
    );


  if (!match) {
    return normalizeKeyText_(
      text
    );
  }


  const month =
    Number(
      match[1]
    );

  const day =
    Number(
      match[2]
    );


  let year =
    Number(
      match[3]
    );


  /*
   * During 2026:
   *
   * 00-26 -> 2000-2026
   * 27-99 -> 1927-1999
   */
  if (
    year < 100
  ) {
    const pivot =
      TIC_DATA_YEAR % 100;


    year =
      year <= pivot
        ? 2000 + year
        : 1900 + year;
  }


  return [
    year,
    String(month).padStart(
      2,
      "0"
    ),
    String(day).padStart(
      2,
      "0"
    )
  ].join(
    "-"
  );
}


/***************************************************************
 * RETURN UNIQUE VALUES
 ***************************************************************/

function uniqueEntries_(
  entries
) {
  const map =
    new Map();


  entries.forEach(
    entry => {

      if (
        !map.has(
          entry.normalized
        )
      ) {
        map.set(
          entry.normalized,
          {
            value:
              entry.value,

            rows: [
              entry.row
            ]
          }
        );

      } else {
        map
          .get(
            entry.normalized
          )
          .rows
          .push(
            entry.row
          );
      }
    }
  );


  return Array.from(
    map.values()
  );
}


/***************************************************************
 * MERGE UNIQUE VALUES
 ***************************************************************/

function mergeUniqueEntries_(
  entries
) {
  const unique =
    uniqueEntries_(
      entries
    );


  return unique
    .map(
      entry =>
        entry.value
    )
    .join(
      "\n\n"
    );
}


