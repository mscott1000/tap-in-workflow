/***************************************************************
 * EXTRACT NOTES FROM SELECTED RANGE
 ***************************************************************/

function extractNotesFromSelection() {
  const spreadsheet =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    spreadsheet.getActiveSheet();

  const range =
    sheet.getActiveRange();


  if (!range) {
    SpreadsheetApp
      .getUi()
      .alert(
        "Please select the cells containing the notes you want to extract."
      );

    return;
  }


  extractNotesFromRange_(
    sheet,
    range
  );
}


/***************************************************************
 * EXTRACT NOTES FROM ENTERED RANGE
 ***************************************************************/

function extractNotesFromEnteredRange() {
  const spreadsheet =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    spreadsheet.getActiveSheet();

  const ui =
    SpreadsheetApp.getUi();


  const response =
    ui.prompt(
      "Extract Cell Notes",

      "Enter the range containing the notes, for example K2:K200",

      ui.ButtonSet.OK_CANCEL
    );


  if (
    response.getSelectedButton() !==
    ui.Button.OK
  ) {
    return;
  }


  const rangeA1 =
    response
      .getResponseText()
      .trim();


  if (!rangeA1) {
    ui.alert(
      "No range was entered."
    );

    return;
  }


  try {
    const range =
      sheet.getRange(
        rangeA1
      );


    extractNotesFromRange_(
      sheet,
      range
    );


  } catch (error) {
    ui.alert(
      `The range "${rangeA1}" could not be read.\n\n` +
      `Please use a range such as K2:K200.`
    );
  }
}


/***************************************************************
 * INTERNAL NOTE EXTRACTION FUNCTION
 ***************************************************************/

function extractNotesFromRange_(
  sourceSheet,
  range
) {
  const spreadsheet =
    SpreadsheetApp.getActiveSpreadsheet();


  /*
   * Read the entire selected range at once.
   */
  const notes =
    range.getNotes();

  const values =
    range.getDisplayValues();


  const startRow =
    range.getRow();

  const startColumn =
    range.getColumn();


  const output = [];


  for (
    let row = 0;
    row < notes.length;
    row++
  ) {
    for (
      let col = 0;
      col < notes[row].length;
      col++
    ) {
      const note =
        notes[row][col];


      /*
       * Ignore cells without Notes.
       */
      if (
        note &&
        note.trim() !== ""
      ) {
        const actualRow =
          startRow +
          row;

        const actualColumn =
          startColumn +
          col;


        const cellAddress =
          sourceSheet
            .getRange(
              actualRow,
              actualColumn
            )
            .getA1Notation();


        output.push([
          sourceSheet.getName(),
          cellAddress,
          values[row][col],
          note
        ]);
      }
    }
  }


  if (
    output.length === 0
  ) {
    SpreadsheetApp
      .getUi()
      .alert(
        `No cell notes were found in ` +
        `${sourceSheet.getName()}!${range.getA1Notation()}`
      );

    return;
  }


  /*
   * Find or create output tab.
   */
  let outputSheet =
    spreadsheet.getSheetByName(
      "Extracted Notes"
    );


  if (!outputSheet) {
    outputSheet =
      spreadsheet.insertSheet(
        "Extracted Notes"
      );
  }


  /*
   * Remove previous output.
   */
  outputSheet.clear();


  const headers = [
    "Source Sheet",
    "Cell",
    "Cell Value",
    "Note Text"
  ];


  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ])
    .setFontWeight(
      "bold"
    );


  outputSheet
    .getRange(
      2,
      1,
      output.length,
      headers.length
    )
    .setValues(
      output
    );


  /*
   * Wrap long note text.
   */
  outputSheet
    .getRange(
      2,
      4,
      output.length,
      1
    )
    .setWrap(
      true
    );


  outputSheet.setFrozenRows(
    1
  );


  /*
   * Column widths.
   */
  outputSheet.setColumnWidth(
    1,
    160
  );

  outputSheet.setColumnWidth(
    2,
    90
  );

  outputSheet.setColumnWidth(
    3,
    220
  );

  outputSheet.setColumnWidth(
    4,
    500
  );


  /*
   * Resize multiline rows.
   */
  outputSheet.autoResizeRows(
    1,
    output.length + 1
  );


  outputSheet.activate();

  outputSheet
    .getRange(
      "A1"
    )
    .activate();


  SpreadsheetApp
    .getUi()
    .alert(
      `Extraction complete.\n\n` +

      `${output.length} note` +
      `${output.length === 1 ? "" : "s"} ` +
      `extracted from ` +

      `${sourceSheet.getName()}!` +
      `${range.getA1Notation()}.`
    );
}


/***************************************************************
 * CLEAR EXTRACTED NOTES
 ***************************************************************/

function clearExtractedNotes() {
  const spreadsheet =
    SpreadsheetApp.getActiveSpreadsheet();


  const outputSheet =
    spreadsheet.getSheetByName(
      "Extracted Notes"
    );


  if (!outputSheet) {
    SpreadsheetApp
      .getUi()
      .alert(
        'There is no "Extracted Notes" sheet to clear.'
      );

    return;
  }


  outputSheet.clear();


  SpreadsheetApp
    .getUi()
    .alert(
      "The Extracted Notes sheet has been cleared."
    );
}
