  sourceSheet
    .getRange(
      sourceRow,
      SOURCE_START_COLUMN + 9,
      1,
      4
    )
    .copyFormatToRange(
      destinationGridId,
      18,
      21,
      destinationRow,
      destinationRow
    );


  /*
   * U
