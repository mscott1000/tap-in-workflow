  sourceSheet
    .getRange(
      sourceRow,
      SOURCE_START_COLUMN + 7,
      1,
      2
    )
    .copyFormatToRange(
      destinationGridId,
      6,
      7,
      destinationRow,
      destinationRow
    );


  /*
   * H
   *
   * Phone Number
   *
   * →
   *
   * H
   */
  sourceSheet
    .getRange(
      sourceRow,
      SOURCE_START_COLUMN + 5
    )
    .copyFormatToRange(
      destinationGridId,
      8,
      8,
      destinationRow,
      destinationRow
    );


  /*
   * P:T
   *
   * Residential Address
   * City
   * State
   * Zip Code
   * Email Address
   *
   * →
   *
   * I:M
   */
  sourceSheet
    .getRange(
      sourceRow,
      SOURCE_START_COLUMN + 13,
      1,
      5
    )
    .copyFormatToRange(
      destinationGridId,
      9,
      13,
      destinationRow,
      destinationRow
    );


  /*
   * AA
   *
   * Notes
   *
   * →
   *
   * Q
   */
  sourceSheet
    .getRange(
      sourceRow,
      SOURCE_START_COLUMN + 24
    )
    .copyFormatToRange(
      destinationGridId,
      17,
      17,
      destinationRow,
      destinationRow
    );


  /*
   * L:O
   *
   * Online Form
   * Location
   * Race
   * Gender
