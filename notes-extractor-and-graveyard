/***************************************************************
 * COPY FORMATTING FROM SOURCE TO DESTINATION
 ***************************************************************/

function copyRecordFormatting_(
  sourceSheet,
  destinationSheet,
  sourceRow,
  destinationRow
) {
  const destinationGridId =
    destinationSheet.getSheetId();


  /*
   * C:G
   *
   * Date / FN / LN / MN / DOB
