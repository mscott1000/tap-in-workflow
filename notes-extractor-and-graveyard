/***************************************************************
 * TIC IMPORTER CONFIGURATION
 ***************************************************************/

const DESTINATION_SHEET_NAME = "Graveyard prototype";

/*
 * Source Intake data begins in column C.
 *
 * A = ignored
 * B = ignored
 * C = first Intake field
 */
const SOURCE_START_COLUMN = 3;

const SOURCE_HEADER_ROW = 1;
const DESTINATION_HEADER_ROW = 1;

const TIC_DATA_YEAR = 2026;


/*
 * Expected Intake structure, beginning in physical column C.
 *
 * C  Date
 * D  FN
 * E  LN
 * F  MN
 * G  DOB
 * H  Phone Number
 * I  Primary Service
 * J  Eligible Cases
 * K  Ineligible Cases
 * L  Online Form
 * M  Location
 * N  Race
 * O  Gender
 * P  Residential Address
 * Q  City
 * R  State
 * S  Zip Code
 * T  Email Address
 * U  Referral Source
 * V  Attorney Status
 * W  Applied for PD?
 * X  Eligible for TBP
 * Y  Established as TBP Client
 * Z  Referred to Holland Law program
 * AA Notes
 */
const SOURCE_HEADERS = [
  "Date",
  "FN",
  "LN",
  "MN",
  "DOB",
  "Phone Number",
  "Primary Service",
  "Eligible Cases",
  "Ineligible Cases",
  "Online Form",
  "Location",
  "Race",
  "Gender",
  "Residential Address",
  "City",
  "State",
  "Zip Code",
  "Email Address",
  "Referral Source",
  "Attorney Status",
  "Applied for PD?",
  "Eligible for TBP",
  "Established as TBP Client",
  "Referred to Holland Law program",
  "Notes"
];


/*
 * Required Graveyard prototype structure.
 */
const DESTINATION_HEADERS = [
  "TIC Week",
  "First Name",
  "Last Name",
  "Middle",
  "DOB",
  "Eligible Cases",
  "Ineligible Cases",
  "Phone Number",
  "Mailing Address",
  "City",
  "State",
  "Zip Code",
  "Email Address",
  "Court Date Obtained",
  "Primary Contact Method",
  "Contact History",
  "Notes",
  "Online Form?",
  "Location",
  "Race",
  "Gender",
  "Referral Source"
];


/*
 * These fields may legitimately contain different information
 * across duplicate source rows.
 *
 * Unique entries will be combined.
 */
const ADDITIVE_FIELDS = new Set([
  "Eligible Cases",
  "Ineligible Cases",
  "Notes"
]);


/*
 * Only these source fields are transferred.
 *
 * Primary Service
 * Attorney Status
 * Applied for PD?
 * Eligible for TBP
 * Established as TBP Client
 * Referred to Holland Law program
 *
 * are intentionally omitted.
 */
const FIELD_MAP = [
  { source: "Date", destination: "TIC Week" },
  { source: "FN", destination: "First Name" },
  { source: "LN", destination: "Last Name" },
  { source: "MN", destination: "Middle" },
  { source: "DOB", destination: "DOB" },

  { source: "Eligible Cases", destination: "Eligible Cases" },
  { source: "Ineligible Cases", destination: "Ineligible Cases" },

  { source: "Phone Number", destination: "Phone Number" },

  { source: "Residential Address", destination: "Mailing Address" },
  { source: "City", destination: "City" },
  { source: "State", destination: "State" },
  { source: "Zip Code", destination: "Zip Code" },
  { source: "Email Address", destination: "Email Address" },

  { source: "Notes", destination: "Notes" },

  { source: "Online Form", destination: "Online Form?" },
  { source: "Location", destination: "Location" },
  { source: "Race", destination: "Race" },
  { source: "Gender", destination: "Gender" },

  { source: "Referral Source", destination: "Referral Source" }
];


