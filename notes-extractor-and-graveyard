/***************************************************************
 * SHOW DUPLICATE CONFLICTS
 ***************************************************************/

function showConflictAlert_(
  ui,
  sourceSheet,
  rowRange,
  conflicts
) {
  const MAX_TO_SHOW =
    10;


  const preview =
    conflicts
      .slice(
        0,
        MAX_TO_SHOW
      )
      .map(
        (conflict, index) => {

          return (
            `${index + 1}. ${conflict.field}\n` +
            `Rows: ${conflict.rows.join(", ")}\n` +
            `Values:\n` +

            conflict.values
              .map(
                value =>
                  `• ${value}`
              )
              .join(
                "\n"
              )
          );
        }
      )
      .join(
        "\n\n"
      );


  const more =
    conflicts.length >
    MAX_TO_SHOW

      ? `\n\n...plus ${conflicts.length - MAX_TO_SHOW} more conflict(s).`

      : "";


  console.log(
    JSON.stringify(
      conflicts,
      null,
      2
    )
  );


  ui.alert(
    "Import Stopped — Conflicting Duplicate Data",

    `No data was written to "${DESTINATION_SHEET_NAME}".\n\n` +

    `Source: ${sourceSheet.getName()}\n` +
    `Rows: ${rowRange.startRow}-${rowRange.endRow}\n` +
    `Columns A and B ignored\n` +
    `Intake data read from C:AA\n\n` +

    `Duplicate client rows contained different values in ` +
    `fields that should agree.\n\n` +

    preview +
    more,

    ui.ButtonSet.OK
  );
}


/***************************************************************
 * COLUMN NUMBER → LETTER
 ***************************************************************/

function columnLetter_(
  column
) {
  let letter =
    "";


  while (
    column > 0
  ) {
    const remainder =
      (column - 1) %
      26;


    letter =
      String.fromCharCode(
        65 +
        remainder
      ) +
      letter;


    column =
      Math.floor(
        (column - 1) /
        26
      );
  }


  return letter;
}


